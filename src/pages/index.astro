---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Fragebogen · Übersicht">
  <main class="landing">
    <section class="hero compact">
      <p class="eyebrow">Fragebogen</p>
      <h1>Unsere Fragebogen</h1>
      <p>Ein gemeinsamer Ort für Einladungen, Rückmeldungen und Terminabsprachen.</p>
      <div class="questionnaire-links">
        <a class="questionnaire-link active" href={`${base}Kollegiumstreffen/`}>
          <span class="questionnaire-number">02</span>
          <span><strong>Kollegiumstreffen</strong><small>Tanz mit Victor & Lea · 14.10.2026</small></span>
        </a>
        <a class="questionnaire-link archived" href={`${base}grundschulsportfeste/`}>
          <span class="questionnaire-number">01</span>
          <span><strong>Grundschulsportfeste 2026/2027</strong><small>Alt-Herne · abgeschlossenes Archiv</small></span>
        </a>
      </div>
    </section>
  </main>
</Layout>
