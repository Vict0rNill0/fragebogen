---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Fragebogen 2 · Kollegiumstreffen"
  description="Anmeldung zum ersten Kollegiumstreffen mit Salsa und Disco-Folk."
>
  <main class="dance-page">
    <section class="dance-hero">
      <div class="dance-title-row">
        <span class="dance-mark" aria-hidden="true">✦</span>
        <h1>Hast du Lust<br /><em>zu tanzen?</em></h1>
      </div>
      <p class="dance-lead">
        Unser erstes Kollegiumstreffen vor den Herbstferien wird beweglich, musikalisch und ein bisschen anders.
      </p>
      <div class="dance-art" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="dance-figure figure-one">✺</span>
        <span class="dance-figure figure-two">✦</span>
      </div>
    </section>

    <section class="dance-details">
      <div class="dance-time">
        <span class="detail-label">Wann?</span>
        <strong>14.10.2026</strong>
        <span>gegen 13:30 Uhr</span>
      </div>
      <div class="dance-place">
        <span class="detail-label">Wo?</span>
        <strong>Foyer der 2. Etage</strong>
        <span>vor dem Sekretariat</span>
      </div>
    </section>

    <section class="dance-program">
      <div class="program-line salsa">
        <span class="program-dot">01</span>
        <div><strong>Salsa</strong><span>mit Victor</span></div>
      </div>
      <div class="program-line folk">
        <span class="program-dot">02</span>
        <div><strong>Disco-Folk</strong><span>mit Lea</span></div>
      </div>
    </section>

    <section class="dance-invite">
      <p>
        Alle sind herzlich eingeladen. Wir haben im Foyer genug Platz, um gemeinsam eine Stunde lang zu tanzen,
        zu lachen und mit Lust auf Bewegung in den Nachmittag zu starten.
      </p>
      <span class="invite-note">Wenn du dabei sein möchtest, bestätige bitte kurz deine Anwesenheit:</span>
    </section>

    <section class="dance-signup" data-dance-signup>
      <div class="signup-heading">
        <span class="detail-label">Dabei?</span>
        <h2>Wer kommt mit?</h2>
        <p>Trag einfach deinen Namen ein. Die Liste wird für alle sichtbar aktualisiert.</p>
      </div>
      <div class="dance-attendees" data-dance-attendees>
        <p class="empty-state">Noch niemand eingetragen.</p>
      </div>
      <form class="dance-form" data-dance-form>
        <label>
          <span>Dein Name</span>
          <input name="name" type="text" autocomplete="name" required maxlength="80" placeholder="z. B. Maria" />
        </label>
        <button type="submit">Ich bin dabei</button>
      </form>
      <div class="dance-status" data-dance-status aria-live="polite"></div>
    </section>

    <a class="back-link" href={`${base}`}>← Zur Fragebogen-Übersicht</a>
  </main>
  <script is:inline src={`${base}collegium.js`} type="module"></script>
</Layout>
